// envoweb.markdown on hostile input (found by envo fuzz): list items with no content.
// expect: <ul>
// expect: <li></li>
// expect: </ul>
// expect: <ol>
// expect: <li></li>
// expect: </ol>
// expect: <ul>
// expect: <li>a</li>
// expect: <li></li>
// expect: </ul>
// expect: invalid UTF-8 becomes U+FFFD
use envoweb.markdown;

write(1, markdown.ToHtml("-").AsStr());
write(1, markdown.ToHtml("1.\n").AsStr());
write(1, markdown.ToHtml("* a\n*").AsStr());
string bad = string.From("a");
bad.AppendByte(0xFF);
bad.Append("b");
string h = markdown.ToHtml(bad.AsStr());
if (h.AsStr().Len == 13 && h.AsStr()[4] == 0xEF) print("invalid UTF-8 becomes U+FFFD");
