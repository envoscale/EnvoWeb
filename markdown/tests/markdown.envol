// envoweb.markdown: the blocks and inlines a document uses, rendered to HTML; heading ids
// and the title; and safety: raw HTML and `javascript:` links are neutralized unless the
// document is trusted.
use envoweb.markdown;

markdown.Doc d = markdown.Render("# Hello *World*\n\nText with `code`, **strong**, _em_, snake_case_name, a [link](docs/x.md#y \"T\") and <https://envoscale.dev>.\nNext line.  \nAfter a hard break.\n\n- one\n- two\n  - nested\n- three\n\n3. third\n4. fourth\n\n> quoted\n> text\n\n```envo\nprint(\"<hi>\");\n```\n\n| a | b |\n|:--|--:|\n| 1 | 2 \\| 3 |\n\n---\n\nSetext\n======\n\n    indented code\n\n## Hello World\n\n![logo](a.png \"Logo\") &amp; &copy;\n", markdown.Options.Site());
write(1, d.HtmlOf());
print(d.Title());
markdown.Heading[] hs = d.HeadingList();
for (usize i = 0; i < hs.Len; i++) {
    if (i > 0) write(1, " ");
    write(1, hs[i].IdOf());
}
print("");
write(1, markdown.ToHtml("<script>alert(1)</script> <b>x</b> [a](javascript:alert(1)) [b](JavaScript:x)\n").AsStr());
write(1, markdown.ToHtml("Tight *emph* but not * this * or 2*3*4, and a_b_c.\n").AsStr());
write(1, markdown.ToHtml("1. a\n\n2. b\n").AsStr());
write(1, markdown.ToHtml("Unclosed `code and [link(\n").AsStr());
// expect: <h1 id="hello-world">Hello <em>World</em></h1>
// expect: <p>Text with <code>code</code>, <strong>strong</strong>, <em>em</em>, snake_case_name, a <a href="docs/x.html#y" title="T">link</a> and <a href="https://envoscale.dev">https://envoscale.dev</a>.
// expect: Next line.<br>
// expect: After a hard break.</p>
// expect: <ul>
// expect: <li>one</li>
// expect: <li>two
// expect: <ul>
// expect: <li>nested</li>
// expect: </ul>
// expect: </li>
// expect: <li>three</li>
// expect: </ul>
// expect: <ol start="3">
// expect: <li>third</li>
// expect: <li>fourth</li>
// expect: </ol>
// expect: <blockquote>
// expect: <p>quoted
// expect: text</p>
// expect: </blockquote>
// expect: <pre><code class="language-envo">print(&quot;&lt;hi&gt;&quot;);
// expect: </code></pre>
// expect: <table>
// expect: <thead>
// expect: <tr><th style="text-align:left">a</th><th style="text-align:right">b</th></tr>
// expect: </thead>
// expect: <tbody>
// expect: <tr><td style="text-align:left">1</td><td style="text-align:right">2 | 3</td></tr>
// expect: </tbody>
// expect: </table>
// expect: <hr>
// expect: <h1 id="setext">Setext</h1>
// expect: <pre><code>indented code
// expect: </code></pre>
// expect: <h2 id="hello-world-1">Hello World</h2>
// expect: <p><img src="a.png" alt="logo" title="Logo"> &amp; &copy;</p>
// expect: Hello World
// expect: hello-world setext hello-world-1
// expect: <p>&lt;script&gt;alert(1)&lt;/script&gt; &lt;b&gt;x&lt;/b&gt; <a href="#">a</a> <a href="#">b</a></p>
// expect: <p>Tight <em>emph</em> but not * this * or 2<em>3</em>4, and a_b_c.</p>
// expect: <ol>
// expect: <li><p>a</p>
// expect: </li>
