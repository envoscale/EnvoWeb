// envoweb.markdown: Markdown to HTML (PLAN D51). The blocks and inlines of CommonMark that
// documents use, plus GitHub's tables:
// - blocks: ATX and setext headings, paragraphs, fenced and indented code, block
//   quotes, bullet and ordered lists (nested, tight or loose), thematic breaks, tables;
// - inlines: code spans, emphasis and strong emphasis (`_` only at word boundaries), links,
//   images, autolinks, backslash escapes, entities, hard line breaks.
// Text is escaped. Raw HTML is escaped too unless Options.RawHtml is set (for trusted
// documents). Headings get ids (slugs) and are listed, so a page can show its contents.
namespace envoweb.markdown;

use core.text as ct;

public struct Options {
    bool RawHtml;       // pass HTML blocks and inline tags through (trusted documents only)
    bool MdLinks;       // rewrite links to `x.md` (and `x.md#y`) as `x.html`

    public static Options Safe() => new Options { RawHtml = false, MdLinks = false };
    public static Options Site() => new Options { RawHtml = true, MdLinks = true };
}

// A heading of the document: its level (1-6), text (without markup) and id.
public struct Heading {
    u32 Level;
    string Text;
    string Id;

    public u32 LevelOf(in this) => this.Level;
    public str TextOf(in this) => this.Text.AsStr();
    public str IdOf(in this) => this.Id.AsStr();
}

// A rendered document.
public struct Doc {
    string Html;
    List<Heading> Headings;

    public str HtmlOf(in this) => this.Html.AsStr();
    public usize HeadingCount(in this) => this.Headings.Len();
    public Heading[] HeadingList(in this) => this.Headings.AsSlice();

    // The first level-1 heading's text, or "".
    public str Title(in this) {
        Heading[] hs = this.Headings.AsSlice();
        for (usize i = 0; i < hs.Len; i++) {
            if (hs[i].Level == 1) return hs[i].Text.AsStr();
        }
        return "";
    }
}

// src with every byte that does not start a valid UTF-8 character replaced by U+FFFD.
string Utf8Clean(str src) {
    string clean = string.New();
    usize i = 0;
    while (i < src.Len) {
        usize ok = ct.Utf8ValidUpTo(ct.ByteSlice(src, i, src.Len));
        clean.Append(ct.ByteSlice(src, i, i + ok));
        i += ok;
        if (i < src.Len) {
            clean.Append("\u{FFFD}");
            i++;
        }
    }
    return clean;
}

// Markdown to HTML, safely (raw HTML escaped).
public string ToHtml(str src) {
    Doc d = Render(src, Options.Safe());
    return d.Html;
}

public Doc Render(str src, Options opts) {
    Parser p = new Parser { Opts = opts, Headings = List<Heading>.New(), Ids = List<string>.New() };
    // bytes that are not UTF-8 become U+FFFD, as browsers do, so the text is all text
    string clean = Utf8Clean(src);
    List<string> lines = SplitLines(clean.AsStr());
    string html = string.New();
    p.Blocks(lines.AsSlice(), ref html);
    return new Doc { Html = html, Headings = p.Headings };
}

// ------------------------------------------------------------------ lines

List<string> SplitLines(str src) {
    List<string> out0 = List<string>.New();
    string cur = string.New();
    for (usize i = 0; i < src.Len; i++) {
        u8 c = src[i];
        if (c == 13) continue;
        if (c == 10) {
            out0.Push(cur);
            cur = string.New();
        } else if (c == 9) {
            // tabs to the next multiple of 4 columns
            cur.AppendByte(' ');
            while (cur.Len() % 4 != 0) cur.AppendByte(' ');
        } else {
            cur.AppendByte(c);
        }
    }
    if (cur.Len() > 0) out0.Push(cur);
    return out0;
}

bool Blank(str l) {
    for (usize i = 0; i < l.Len; i++) {
        if (l[i] != ' ') return false;
    }
    return true;
}

usize Indent(str l) {
    usize n = 0;
    while (n < l.Len && l[n] == ' ') n++;
    return n;
}

str TrimStr(str s) {
    usize a = 0;
    usize b = s.Len;
    while (a < b && s[a] == ' ') a++;
    while (b > a && s[b - 1] == ' ') b--;
    return s[a..b];
}

bool StartsWith(str s, str p) => BytesAt(s, 0, p);

// Does s hold p at byte offset at? (Byte-wise: no slice that could split a character.)
bool BytesAt(str s, usize at, str p) {
    if (at > s.Len || s.Len - at < p.Len) return false;
    for (usize i = 0; i < p.Len; i++) {
        if (s[at + i] != p[i]) return false;
    }
    return true;
}

bool Same(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// A fence (``` or ~~~, 3 or more) after up to 3 spaces: its character and length, else 0.
usize Fence(str l, ref u8 ch) {
    usize i = Indent(l);
    if (i > 3 || i >= l.Len) return 0;
    u8 c = l[i];
    if (c != '`' && c != '~') return 0;
    usize n = 0;
    while (i + n < l.Len && l[i + n] == c) n++;
    if (n < 3) return 0;
    if (c == '`') {
        for (usize k = i + n; k < l.Len; k++) {
            if (l[k] == '`') return 0;
        }
    }
    ch = c;
    return n;
}

// An ATX heading's level, or 0.
u32 AtxLevel(str l) {
    usize i = Indent(l);
    if (i > 3) return 0;
    u32 n = 0;
    while (i + (n as usize) < l.Len && l[i + n as usize] == '#') n++;
    if (n == 0 || n > 6) return 0;
    usize after = i + n as usize;
    if (after < l.Len && l[after] != ' ') return 0;
    return n;
}

bool ThematicBreak(str l) {
    usize i = Indent(l);
    if (i > 3 || i >= l.Len) return false;
    u8 c = l[i];
    if (c != '-' && c != '*' && c != '_') return false;
    u32 n = 0;
    for (usize k = i; k < l.Len; k++) {
        if (l[k] == c) n++;
        else if (l[k] != ' ') return false;
    }
    return n >= 3;
}

bool QuoteLine(str l) {
    usize i = Indent(l);
    return i <= 3 && i < l.Len && l[i] == '>';
}

// A list item's marker: its kind ('-', '*', '+', or '.'/')' for ordered), number, and
// the column where its content starts; false if l does not start an item.
bool ListMarker(str l, ref u8 kind, ref u64 number, ref usize content) {
    usize i = Indent(l);
    if (i > 3 || i >= l.Len) return false;
    u8 c = l[i];
    if (c == '-' || c == '*' || c == '+') {
        if (i + 1 < l.Len && l[i + 1] != ' ') return false;
        kind = c;
        number = 0;
        usize s = i + 1;
        usize sp = 0;
        while (s + sp < l.Len && l[s + sp] == ' ' && sp < 4) sp++;
        if (sp == 0 || sp == 4 || s + sp >= l.Len) sp = 1;
        content = s + sp;
        if (content > l.Len) content = l.Len;    // an empty item: `-` alone
        return true;
    }
    usize d = 0;
    u64 v = 0;
    while (i + d < l.Len && l[i + d] >= '0' && l[i + d] <= '9' && d < 9) {
        v = v * 10 + (l[i + d] - '0') as u64;
        d++;
    }
    if (d == 0 || i + d >= l.Len) return false;
    u8 m = l[i + d];
    if (m != '.' && m != ')') return false;
    if (i + d + 1 < l.Len && l[i + d + 1] != ' ') return false;
    kind = m;
    number = v;
    usize s = i + d + 1;
    usize sp = 0;
    while (s + sp < l.Len && l[s + sp] == ' ' && sp < 4) sp++;
    if (sp == 0 || sp == 4 || s + sp >= l.Len) sp = 1;
    content = s + sp;
    if (content > l.Len) content = l.Len;        // an empty item: `1.` alone
    return true;
}

// A table's delimiter row: the columns' alignments ('l', 'c', 'r' or ' '), or empty.
List<u8> Delimiter(str l) {
    List<u8> aligns = List<u8>.New();
    List<string> cells = Cells(l);
    if (cells.Len() == 0) return aligns;
    string[] cs = cells.AsSlice();
    for (usize k = 0; k < cs.Len; k++) {
        str c = TrimStr(cs[k].AsStr());
        if (c.Len == 0) return List<u8>.New();
        bool left = c[0] == ':';
        bool right = c[c.Len - 1] == ':';
        usize a = 0;
        usize b = c.Len;
        if (left) a = 1;
        if (right && b > a) b--;
        if (b <= a) return List<u8>.New();
        for (usize i = a; i < b; i++) {
            if (c[i] != '-') return List<u8>.New();
        }
        if (left && right) aligns.Push('c');
        else if (left) aligns.Push('l');
        else if (right) aligns.Push('r');
        else aligns.Push(' ');
    }
    return aligns;
}

// A table row's cells: split on unescaped `|`, outer pipes dropped.
List<string> Cells(str l0) {
    List<string> cells = List<string>.New();
    str l = TrimStr(l0);
    if (l.Len == 0) return cells;
    usize a = 0;
    usize b = l.Len;
    if (l[0] == '|') a = 1;
    if (b > a && l[b - 1] == '|' && !(b >= 2 && l[b - 2] == 92)) b--;
    string cur = string.New();
    bool any = l[0] == '|';
    usize i = a;
    while (i < b) {
        u8 c = l[i];
        if (c == 92 && i + 1 < b && l[i + 1] == '|') {
            cur.AppendByte('|');
            i += 2;
            continue;
        }
        if (c == '|') {
            cells.Push(cur);
            cur = string.New();
            any = true;
        } else {
            cur.AppendByte(c);
        }
        i++;
    }
    cells.Push(cur);
    if (!any) return List<string>.New();
    return cells;
}

// ------------------------------------------------------------------ blocks

struct Parser {
    Options Opts;
    List<Heading> Headings;
    List<string> Ids;

    void Blocks(ref this, string[] lines, ref string html) {
        usize i = 0;
        while (i < lines.Len) {
            str l = lines[i].AsStr();
            if (Blank(l)) {
                i++;
                continue;
            }
            u8 fch = 0;
            usize flen = Fence(l, ref fch);
            if (flen > 0) {
                i = this.FencedCode(lines, i, fch, flen, ref html);
                continue;
            }
            u32 level = AtxLevel(l);
            if (level > 0) {
                str t = TrimStr(l[Indent(l) + level as usize..l.Len]);
                // a closing run of #s
                usize e = t.Len;
                while (e > 0 && t[e - 1] == '#') e--;
                if (e == 0 || t[e - 1] == ' ') t = TrimStr(t[0..e]);
                this.HeadingHtml(level, t, ref html);
                i++;
                continue;
            }
            if (ThematicBreak(l)) {
                html.Append("<hr>\n");
                i++;
                continue;
            }
            if (QuoteLine(l)) {
                List<string> inner = List<string>.New();
                while (i < lines.Len && !Blank(lines[i].AsStr())) {
                    str q = lines[i].AsStr();
                    if (QuoteLine(q)) {
                        usize k = Indent(q) + 1;
                        if (k < q.Len && q[k] == ' ') k++;
                        inner.Push(string.From(q[k..q.Len]));
                    } else {
                        inner.Push(string.From(q));
                    }
                    i++;
                }
                html.Append("<blockquote>\n");
                this.Blocks(inner.AsSlice(), ref html);
                html.Append("</blockquote>\n");
                continue;
            }
            u8 kind = 0;
            u64 number = 0;
            usize content = 0;
            if (ListMarker(l, ref kind, ref number, ref content)) {
                i = this.ListBlock(lines, i, ref html);
                continue;
            }
            if (Indent(l) >= 4) {
                html.Append("<pre><code>");
                usize end = i;
                while (end < lines.Len && (Blank(lines[end].AsStr()) || Indent(lines[end].AsStr()) >= 4)) end++;
                while (end > i && Blank(lines[end - 1].AsStr())) end--;
                for (usize k = i; k < end; k++) {
                    str c = lines[k].AsStr();
                    if (c.Len >= 4) Escape(ref html, c[4..c.Len]);
                    html.AppendByte(10);
                }
                html.Append("</code></pre>\n");
                i = end;
                continue;
            }
            if (this.Opts.RawHtml && Indent(l) <= 3 && HtmlStart(TrimStr(l))) {
                while (i < lines.Len && !Blank(lines[i].AsStr())) {
                    html.Append(lines[i].AsStr());
                    html.AppendByte(10);
                    i++;
                }
                continue;
            }
            if (i + 1 < lines.Len && HasPipe(l) && Delimiter(lines[i + 1].AsStr()).Len() > 0) {
                i = this.Table(lines, i, ref html);
                continue;
            }
            // a paragraph, to a blank line or the start of another block
            string text = string.New();
            usize start = i;
            while (i < lines.Len) {
                str c = lines[i].AsStr();
                if (Blank(c)) break;
                if (i > start) {
                    u8 fc = 0;
                    u8 k2 = 0;
                    u64 n2 = 0;
                    usize c2 = 0;
                    if (Fence(c, ref fc) > 0 || AtxLevel(c) > 0 || QuoteLine(c) || ThematicBreak(c) && !SetextLine(c, '-')) break;
                    if (ListMarker(c, ref k2, ref n2, ref c2) && (k2 == '-' || k2 == '*' || k2 == '+' || n2 == 1)) break;
                    if (SetextLine(c, '=') || SetextLine(c, '-')) {
                        u32 lv = 1;
                        if (SetextLine(c, '-')) lv = 2;
                        this.HeadingHtml(lv, TrimStr(text.AsStr()), ref html);
                        text = string.New();
                        i++;
                        break;
                    }
                    text.AppendByte(10);
                }
                text.Append(TrimLeft(c));
                i++;
            }
            if (text.Len() > 0) {
                html.Append("<p>");
                this.Inline(TrimRight(text.AsStr()), ref html);
                html.Append("</p>\n");
            }
        }
    }

    usize FencedCode(ref this, string[] lines, usize at, u8 fch, usize flen, ref string html) {
        str open = lines[at].AsStr();
        usize indent = Indent(open);
        str info = TrimStr(open[indent + flen..open.Len]);
        usize sp = 0;
        while (sp < info.Len && info[sp] != ' ') sp++;
        str lang = info[0..sp];
        html.Append("<pre><code");
        if (lang.Len > 0) {
            html.Append(" class=\"language-");
            Escape(ref html, lang);
            html.AppendByte('"');
        }
        html.AppendByte('>');
        usize i = at + 1;
        while (i < lines.Len) {
            str l = lines[i].AsStr();
            u8 c2 = 0;
            usize n2 = Fence(l, ref c2);
            if (n2 >= flen && c2 == fch && Blank(l[Indent(l) + n2..l.Len])) {
                i++;
                break;
            }
            // drop up to the opening fence's indentation
            usize drop = Indent(l);
            if (drop > indent) drop = indent;
            Escape(ref html, l[drop..l.Len]);
            html.AppendByte(10);
            i++;
        }
        html.Append("</code></pre>\n");
        return i;
    }

    // A list starting at line at: its items, each rendered as blocks.
    usize ListBlock(ref this, string[] lines, usize at, ref string html) {
        u8 kind = 0;
        u64 number = 0;
        usize content = 0;
        ListMarker(lines[at].AsStr(), ref kind, ref number, ref content);
        bool ordered = kind == '.' || kind == ')';
        if (ordered) {
            html.Append("<ol");
            if (number != 1) {
                html.Append(" start=\"");
                html.Append(Num(number).AsStr());
                html.AppendByte('"');
            }
            html.Append(">\n");
        } else {
            html.Append("<ul>\n");
        }
        // gather the items' lines first, to know if the list is loose
        List<List<string>> items = List<List<string>>.New();
        bool loose = false;
        usize i = at;
        while (i < lines.Len) {
            str l = lines[i].AsStr();
            u8 k = 0;
            u64 n = 0;
            usize c = 0;
            if (!ListMarker(l, ref k, ref n, ref c) || k != kind) break;
            List<string> item = List<string>.New();
            item.Push(string.From(l[c..l.Len]));
            i++;
            bool sawBlank = false;
            while (i < lines.Len) {
                str m = lines[i].AsStr();
                if (Blank(m)) {
                    sawBlank = true;
                    item.Push(string.New());
                    i++;
                    continue;
                }
                if (Indent(m) >= c) {
                    if (sawBlank) loose = true;
                    item.Push(string.From(m[c..m.Len]));
                    sawBlank = false;
                    i++;
                    continue;
                }
                u8 k2 = 0;
                u64 n2 = 0;
                usize c2 = 0;
                if (sawBlank) break;
                if (ListMarker(m, ref k2, ref n2, ref c2) || AtxLevel(m) > 0 || QuoteLine(m) || ThematicBreak(m)) break;
                u8 fc = 0;
                if (Fence(m, ref fc) > 0) break;
                // a lazy continuation of the item's paragraph
                item.Push(string.From(TrimLeft(m)));
                i++;
            }
            // blank lines between items make the list loose
            if (sawBlank && i < lines.Len) {
                u8 k3 = 0;
                u64 n3 = 0;
                usize c3 = 0;
                if (ListMarker(lines[i].AsStr(), ref k3, ref n3, ref c3) && k3 == kind) loose = true;
            }
            while (item.Len() > 0 && item.AsSlice()[item.Len() - 1].Len() == 0) item.Pop();
            items.Push(item);
        }
        List<string>[] all = items.AsSlice();
        for (usize k = 0; k < all.Len; k++) {
            string inner = string.New();
            this.Blocks(all[k].AsSlice(), ref inner);
            html.Append("<li>");
            if (loose) html.Append(inner.AsStr());
            else html.Append(Untight(inner.AsStr()).AsStr());
            html.Append("</li>\n");
        }
        if (ordered) html.Append("</ol>\n");
        else html.Append("</ul>\n");
        return i;
    }

    usize Table(ref this, string[] lines, usize at, ref string html) {
        List<string> head = Cells(lines[at].AsStr());
        List<u8> aligns = Delimiter(lines[at + 1].AsStr());
        u8[] al = aligns.AsSlice();
        html.Append("<table>\n<thead>\n<tr>");
        string[] hc = head.AsSlice();
        for (usize k = 0; k < al.Len; k++) {
            html.Append("<th");
            AlignAttr(ref html, al[k]);
            html.AppendByte('>');
            if (k < hc.Len) this.Inline(TrimStr(hc[k].AsStr()), ref html);
            html.Append("</th>");
        }
        html.Append("</tr>\n</thead>\n");
        usize i = at + 2;
        bool body = false;
        while (i < lines.Len) {
            str l = lines[i].AsStr();
            if (Blank(l) || !HasPipe(l)) break;
            if (!body) {
                html.Append("<tbody>\n");
                body = true;
            }
            List<string> row = Cells(l);
            string[] rc = row.AsSlice();
            html.Append("<tr>");
            for (usize k = 0; k < al.Len; k++) {
                html.Append("<td");
                AlignAttr(ref html, al[k]);
                html.AppendByte('>');
                if (k < rc.Len) this.Inline(TrimStr(rc[k].AsStr()), ref html);
                html.Append("</td>");
            }
            html.Append("</tr>\n");
            i++;
        }
        if (body) html.Append("</tbody>\n");
        html.Append("</table>\n");
        return i;
    }

    void HeadingHtml(ref this, u32 level, str raw, ref string html) {
        string inner = string.New();
        this.Inline(raw, ref inner);
        string plain = PlainText(inner.AsStr());
        string id = this.UniqueId(Slug(plain.AsStr()).AsStr());
        html.Append("<h");
        html.AppendByte(('0' as u32 + level) as u8);
        html.Append(" id=\"");
        html.Append(id.AsStr());
        html.Append("\">");
        html.Append(inner.AsStr());
        html.Append("</h");
        html.AppendByte(('0' as u32 + level) as u8);
        html.Append(">\n");
        this.Headings.Push(new Heading { Level = level, Text = plain, Id = id });
    }

    string UniqueId(ref this, str slug) {
        string base0 = string.From(slug);
        if (base0.Len() == 0) base0 = string.From("section");
        string id = string.From(base0.AsStr());
        u64 n = 1;
        while (this.Taken(id.AsStr())) {
            id = string.From(base0.AsStr());
            id.AppendByte('-');
            id.Append(Num(n).AsStr());
            n++;
        }
        this.Ids.Push(string.From(id.AsStr()));
        return id;
    }

    bool Taken(in this, str id) {
        string[] ids = this.Ids.AsSlice();
        for (usize i = 0; i < ids.Len; i++) {
            if (ids[i].Equals(id)) return true;
        }
        return false;
    }

    // ---------------------------------------------------------------- inlines

    void Inline(ref this, str s, ref string html) {
        usize i = 0;
        while (i < s.Len) {
            u8 c = s[i];
            if (c == 92 && i + 1 < s.Len) {
                u8 d = s[i + 1];
                if (d == 10) {
                    html.Append("<br>\n");
                    i += 2;
                    continue;
                }
                if (Punct(d)) {
                    EscapeByte(ref html, d);
                    i += 2;
                    continue;
                }
            }
            if (c == '`') {
                usize run = 0;
                while (i + run < s.Len && s[i + run] == '`') run++;
                usize close = FindRun(s, i + run, run);
                if (close != s.Len) {
                    str code = s[i + run..close];
                    // a newline is a space; one space on each side is dropped
                    string cs = string.New();
                    for (usize k = 0; k < code.Len; k++) {
                        if (code[k] == 10) cs.AppendByte(' ');
                        else cs.AppendByte(code[k]);
                    }
                    str cv = cs.AsStr();
                    if (cv.Len >= 2 && cv[0] == ' ' && cv[cv.Len - 1] == ' ' && !Blank(cv)) cv = cv[1..cv.Len - 1];
                    html.Append("<code>");
                    Escape(ref html, cv);
                    html.Append("</code>");
                    i = close + run;
                    continue;
                }
                for (usize k = 0; k < run; k++) html.AppendByte('`');
                i += run;
                continue;
            }
            if (c == '!' && i + 1 < s.Len && s[i + 1] == '[') {
                usize used = this.Link(s, i + 1, true, ref html);
                if (used > 0) {
                    i = used;
                    continue;
                }
            }
            if (c == '[') {
                usize used = this.Link(s, i, false, ref html);
                if (used > 0) {
                    i = used;
                    continue;
                }
            }
            if (c == '<') {
                usize used = this.Angle(s, i, ref html);
                if (used > 0) {
                    i = used;
                    continue;
                }
            }
            if (c == '*' || c == '_') {
                usize used = this.Emphasis(s, i, ref html);
                if (used > 0) {
                    i = used;
                    continue;
                }
            }
            if (c == '&') {
                usize e = Entity(s, i);
                if (e > 0) {
                    html.Append(s[i..e]);
                    i = e;
                    continue;
                }
            }
            if (c == 10) {
                // two spaces before a line break make a hard break
                if (html.Len() >= 2 && EndsWithSpaces(html.AsStr())) {
                    TrimTrailingSpaces(ref html);
                    html.Append("<br>\n");
                } else {
                    html.AppendByte(10);
                }
                i++;
                continue;
            }
            EscapeByte(ref html, c);
            i++;
        }
    }

    // [text](url "title") or ![alt](src): the index after it, or 0.
    usize Link(ref this, str s, usize open, bool image, ref string html) {
        usize depth = 0;
        usize k = open;
        usize close = s.Len;
        while (k < s.Len) {
            u8 c = s[k];
            if (c == 92) {
                k += 2;
                continue;
            }
            if (c == '`') {
                usize run = 0;
                while (k + run < s.Len && s[k + run] == '`') run++;
                usize e = FindRun(s, k + run, run);
                if (e != s.Len) {
                    k = e + run;
                    continue;
                }
            }
            if (c == '[') depth++;
            if (c == ']') {
                depth--;
                if (depth == 0) {
                    close = k;
                    break;
                }
            }
            k++;
        }
        if (close == s.Len || close + 1 >= s.Len || s[close + 1] != '(') return 0;
        usize p = close + 2;
        while (p < s.Len && s[p] == ' ') p++;
        usize us = p;
        bool angle = p < s.Len && s[p] == '<';
        if (angle) {
            us = p + 1;
            p = us;
            while (p < s.Len && s[p] != '>' && s[p] != 10) p++;
            if (p >= s.Len || s[p] != '>') return 0;
        } else {
            usize parens = 0;
            while (p < s.Len && s[p] != ' ' && s[p] != 10) {
                if (s[p] == '(') parens++;
                if (s[p] == ')') {
                    if (parens == 0) break;
                    parens--;
                }
                p++;
            }
        }
        str url = s[us..p];
        if (angle) p++;
        while (p < s.Len && (s[p] == ' ' || s[p] == 10)) p++;
        str title = "";
        if (p < s.Len && (s[p] == '"' || s[p] == 39)) {
            u8 q = s[p];
            usize t0 = p + 1;
            usize t1 = t0;
            while (t1 < s.Len && s[t1] != q) t1++;
            if (t1 >= s.Len) return 0;
            title = s[t0..t1];
            p = t1 + 1;
            while (p < s.Len && s[p] == ' ') p++;
        }
        if (p >= s.Len || s[p] != ')') return 0;
        string href = this.Href(url);
        if (image) {
            html.Append("<img src=\"");
            html.Append(href.AsStr());
            html.Append("\" alt=\"");
            string alt = string.New();
            this.Inline(s[open + 1..close], ref alt);
            Escape(ref html, PlainText(alt.AsStr()).AsStr());
            html.AppendByte('"');
            if (title.Len > 0) {
                html.Append(" title=\"");
                Escape(ref html, title);
                html.AppendByte('"');
            }
            html.AppendByte('>');
        } else {
            html.Append("<a href=\"");
            html.Append(href.AsStr());
            html.AppendByte('"');
            if (title.Len > 0) {
                html.Append(" title=\"");
                Escape(ref html, title);
                html.AppendByte('"');
            }
            html.AppendByte('>');
            this.Inline(s[open + 1..close], ref html);
            html.Append("</a>");
        }
        return p + 1;
    }

    // A URL made safe for an attribute: escaped, `javascript:` refused, `.md` rewritten.
    string Href(ref this, str url0) {
        string url = string.New();
        for (usize i = 0; i < url0.Len; i++) {
            if (url0[i] == 92 && i + 1 < url0.Len && Punct(url0[i + 1])) continue;
            url.AppendByte(url0[i]);
        }
        str u = url.AsStr();
        string lower = string.New();
        for (usize i = 0; i < u.Len && i < 16; i++) {
            u8 c = u[i];
            if (c >= 'A' && c <= 'Z') c = c + 32;
            if (c != ' ') lower.AppendByte(c);
        }
        if (StartsWith(lower.AsStr(), "javascript:") || StartsWith(lower.AsStr(), "vbscript:") || StartsWith(lower.AsStr(), "data:text")) return string.From("#");
        string out0 = string.New();
        if (this.Opts.MdLinks && !ct.Contains(u, "://")) {
            usize hash = u.Len;
            for (usize i = 0; i < u.Len; i++) {
                if (u[i] == '#') {
                    hash = i;
                    break;
                }
            }
            str path = u[0..hash];
            if (path.Len > 3 && BytesAt(path, path.Len - 3, ".md")) {
                string r = string.From(path[0..path.Len - 3]);
                r.Append(".html");
                r.Append(u[hash..u.Len]);
                EscapeAttr(ref out0, r.AsStr());
                return out0;
            }
        }
        EscapeAttr(ref out0, u);
        return out0;
    }

    // <https://…> and <name@host> autolinks and, with RawHtml, inline tags: the index
    // after, or 0.
    usize Angle(ref this, str s, usize at, ref string html) {
        usize k = at + 1;
        while (k < s.Len && s[k] != '>' && s[k] != ' ' && s[k] != 10 && s[k] != '<') k++;
        if (k < s.Len && s[k] == '>') {
            str inner = s[at + 1..k];
            bool url = ct.Contains(inner, "://");
            bool mail = !url && ct.Contains(inner, "@") && !ct.Contains(inner, ":");
            if (url || mail) {
                html.Append("<a href=\"");
                if (mail) html.Append("mailto:");
                html.Append(this.Href(inner).AsStr());
                html.Append("\">");
                Escape(ref html, inner);
                html.Append("</a>");
                return k + 1;
            }
        }
        if (this.Opts.RawHtml && at + 1 < s.Len) {
            u8 c = s[at + 1];
            if (c == '/' || c == '!' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
                usize e = at + 1;
                while (e < s.Len && s[e] != '>') e++;
                if (e < s.Len) {
                    html.Append(s[at..e + 1]);
                    return e + 1;
                }
            }
        }
        return 0;
    }

    // *em*, **strong**, _em_, __strong__: the index after, or 0.
    usize Emphasis(ref this, str s, usize at, ref string html) {
        u8 c = s[at];
        usize run = 0;
        while (at + run < s.Len && s[at + run] == c) run++;
        if (run > 3) return 0;
        // left-flanking: not followed by a space; `_` must not be inside a word
        if (at + run >= s.Len || s[at + run] == ' ' || s[at + run] == 10) return 0;
        if (c == '_' && at > 0 && WordByte(s[at - 1])) return 0;
        usize want = run;
        if (want == 3) want = 2;
        // the closing run: not preceded by a space
        usize k = at + run;
        while (k < s.Len) {
            if (s[k] == 92) {
                k += 2;
                continue;
            }
            if (s[k] == '`') {
                usize r2 = 0;
                while (k + r2 < s.Len && s[k + r2] == '`') r2++;
                usize e = FindRun(s, k + r2, r2);
                if (e != s.Len) {
                    k = e + r2;
                    continue;
                }
                k += r2;
                continue;
            }
            if (s[k] == c) {
                usize r = 0;
                while (k + r < s.Len && s[k + r] == c) r++;
                bool rightFlank = s[k - 1] != ' ' && s[k - 1] != 10;
                bool wordAfter = c == '_' && k + r < s.Len && WordByte(s[k + r]);
                if (r >= want && rightFlank && !wordAfter) {
                    str inner = s[at + want..k];
                    if (want == 2) html.Append("<strong>");
                    else html.Append("<em>");
                    this.Inline(inner, ref html);
                    if (want == 2) html.Append("</strong>");
                    else html.Append("</em>");
                    return k + want;
                }
                k += r;
                continue;
            }
            k++;
        }
        return 0;
    }
}

// ------------------------------------------------------------------ helpers

// Does l start an HTML block: a comment, or a block-level tag (CommonMark's kinds 2 and
// 6)? Inline tags (<b>, <a>) stay in their paragraph.
bool HtmlStart(str l) {
    if (l.Len < 2 || l[0] != '<') return false;
    if (StartsWith(l, "<!--")) return true;
    usize i = 1;
    if (l[i] == '/') i++;
    usize s = i;
    while (i < l.Len && ((l[i] >= 'a' && l[i] <= 'z') || (l[i] >= 'A' && l[i] <= 'Z') || (l[i] >= '0' && l[i] <= '9'))) i++;
    if (i == s) return false;
    if (i < l.Len && l[i] != ' ' && l[i] != '>' && l[i] != '/') return false;
    string name = string.New();
    for (usize k = s; k < i; k++) {
        u8 c = l[k];
        if (c >= 'A' && c <= 'Z') c = c + 32;
        name.AppendByte(c);
    }
    str blocks = " address article aside blockquote details dialog div dl dt dd fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header hr main nav ol p picture pre section summary table tbody td tfoot th thead tr ul script style svg video iframe ";
    string key = string.From(" ");
    key.Append(name.AsStr());
    key.AppendByte(' ');
    return ct.Contains(blocks, key.AsStr());
}

bool SetextLine(str l, u8 c) {
    usize i = Indent(l);
    if (i > 3 || i >= l.Len) return false;
    usize k = i;
    while (k < l.Len && l[k] == c) k++;
    if (k == i) return false;
    return Blank(l[k..l.Len]);
}

str TrimLeft(str s) {
    usize a = 0;
    while (a < s.Len && s[a] == ' ') a++;
    return s[a..s.Len];
}

str TrimRight(str s) {
    usize b = s.Len;
    while (b > 0 && (s[b - 1] == ' ' || s[b - 1] == 10)) b--;
    return s[0..b];
}

// A tight item's paragraph loses its <p> (it may be followed by a nested list).
string Untight(str s) {
    if (StartsWith(s, "<p>") && s.Len >= 8) {
        str rest = s[3..s.Len];
        for (usize i = 0; i + 4 < rest.Len; i++) {
            if (BytesAt(rest, i, "</p>\n")) {
                str after = rest[i + 5..rest.Len];
                if (ct.Contains(after, "<p>")) return string.From(s);
                string t = string.From(rest[0..i]);
                if (after.Len > 0) t.AppendByte(10);
                t.Append(after);
                // no newline before </li> after a lone paragraph
                str tv = t.AsStr();
                if (after.Len == 0 && tv.Len > 0 && tv[tv.Len - 1] == 10) return string.From(tv[0..tv.Len - 1]);
                return t;
            }
        }
    }
    return string.From(s);
}

bool HasPipe(str l) {
    for (usize i = 0; i < l.Len; i++) {
        if (l[i] == '|') return true;
    }
    return false;
}

bool Punct(u8 c) => (c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126);

bool WordByte(u8 c) => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c >= 0x80;

// The next run of exactly n backticks at or after from, or s.Len.
usize FindRun(str s, usize from, usize n) {
    usize k = from;
    while (k < s.Len) {
        if (s[k] == '`') {
            usize r = 0;
            while (k + r < s.Len && s[k + r] == '`') r++;
            if (r == n) return k;
            k += r;
        } else {
            k++;
        }
    }
    return s.Len;
}

// An entity (&name; &#123; &#x1F;) at s[at]: the index after it, or 0.
usize Entity(str s, usize at) {
    usize k = at + 1;
    if (k < s.Len && s[k] == '#') k++;
    usize start = k;
    while (k < s.Len && k - start < 32 && WordByte(s[k])) k++;
    if (k == start || k >= s.Len || s[k] != ';') return 0;
    return k + 1;
}

bool EndsWithSpaces(str s) => s.Len >= 2 && s[s.Len - 1] == ' ' && s[s.Len - 2] == ' ';

void TrimTrailingSpaces(ref string s) {
    str v = s.AsStr();
    usize b = v.Len;
    while (b > 0 && v[b - 1] == ' ') b--;
    string t = string.From(v[0..b]);
    s = t;
}

void AlignAttr(ref string html, u8 a) {
    if (a == 'l') html.Append(" style=\"text-align:left\"");
    else if (a == 'c') html.Append(" style=\"text-align:center\"");
    else if (a == 'r') html.Append(" style=\"text-align:right\"");
}

// Text with tags removed and entities for &, <, > decoded back: a heading's plain text.
string PlainText(str html) {
    string s = string.New();
    usize i = 0;
    while (i < html.Len) {
        if (html[i] == '<') {
            while (i < html.Len && html[i] != '>') i++;
            i++;
            continue;
        }
        if (html[i] == '&') {
            if (StartsWith(html[i..html.Len], "&amp;")) {
                s.AppendByte('&');
                i += 5;
                continue;
            }
            if (StartsWith(html[i..html.Len], "&lt;")) {
                s.AppendByte('<');
                i += 4;
                continue;
            }
            if (StartsWith(html[i..html.Len], "&gt;")) {
                s.AppendByte('>');
                i += 4;
                continue;
            }
            if (StartsWith(html[i..html.Len], "&quot;")) {
                s.AppendByte('"');
                i += 6;
                continue;
            }
        }
        s.AppendByte(html[i]);
        i++;
    }
    return s;
}

// A heading's id: lower case, letters, digits, `-` and `_`; spaces become `-`.
public string Slug(str text) {
    string s = string.New();
    for (usize i = 0; i < text.Len; i++) {
        u8 c = text[i];
        if (c >= 'A' && c <= 'Z') s.AppendByte(c + 32);
        else if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c >= 0x80) s.AppendByte(c);
        else if (c == ' ') s.AppendByte('-');
    }
    return s;
}

// HTML text: &, <, > and " escaped.
public void Escape(ref string html, str s) {
    for (usize i = 0; i < s.Len; i++) EscapeByte(ref html, s[i]);
}

void EscapeByte(ref string html, u8 c) {
    if (c == '&') html.Append("&amp;");
    else if (c == '<') html.Append("&lt;");
    else if (c == '>') html.Append("&gt;");
    else if (c == '"') html.Append("&quot;");
    else html.AppendByte(c);
}

// An attribute value: escaped, with entities kept.
void EscapeAttr(ref string html, str s) {
    usize i = 0;
    while (i < s.Len) {
        u8 c = s[i];
        if (c == '&') {
            usize e = Entity(s, i);
            if (e > 0) {
                html.Append(s[i..e]);
                i = e;
                continue;
            }
        }
        if (c == ' ') html.Append("%20");
        else EscapeByte(ref html, c);
        i++;
    }
}

string Num(u64 v) {
    if (v == 0) return string.From("0");
    u8[20] d;
    usize n = 0;
    u64 x = v;
    while (x > 0) {
        d[n] = ('0' as u64 + x % 10) as u8;
        x = x / 10;
        n++;
    }
    string s = string.New();
    while (n > 0) {
        n--;
        s.AppendByte(d[n]);
    }
    return s;
}
