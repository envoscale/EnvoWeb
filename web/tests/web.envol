// envoweb: HTML that escapes by default; routes with parameters, 404 and 405; static
// files with their types, a folder's index.html, and paths that try to leave the folder
// refused; and a site built to files from the same pages it serves.
// os: none
// expect: <p class="x&quot;y">a &lt; b &amp; c</p><a href="/?q=1&amp;r=2">go</a>
// expect: GET / -> 200 home
// expect: GET /docs/intro -> 200 doc intro
// expect: GET /files/a/b/c -> 200 rest a/b/c
// expect: POST /docs/x -> 405
// expect: GET /nowhere -> 404
// expect: GET /assets/site.css -> 200 text/css; charset=utf-8 [body{}]
// expect: GET /assets/ -> 200 text/html; charset=utf-8 [index]
// expect: GET /assets/../secret.txt -> 404
// expect: GET /assets/a\b -> 404
// expect: HEAD / -> 200
// expect: built 4 files: home [home], doc [doc intro.html], css [body{}], index [index]
// expect: types: image/svg+xml application/wasm application/octet-stream
// expect: served: HTTP 200 [doc served]
use envoweb as web;
use envo.http;
use ports.{IFileSystem, INet, IoError};
use os.none;
use platform;

http.Response Home(in http.Request req, in web.Params ps) => http.Response.Html(200, "home");

http.Response DocPage(in http.Request req, in web.Params ps) {
    string body = string.From("doc ");
    body.Append(ps.Get("page"));
    return http.Response.Html(200, body.AsStr());
}

http.Response Rest(in http.Request req, in web.Params ps) {
    string body = string.From("rest ");
    body.Append(ps.Get("path"));
    return http.Response.Text(200, body.AsStr());
}

void Show<F>(ref F files, in web.App app, str method, str target) where F : IFileSystem {
    http.Request req = http.Request.New(method, target);
    http.Response r = app.HandleWith(ref files, req);
    write(1, method);
    write(1, " ");
    write(1, target);
    write(1, " -> ");
    write(1, Num(r.StatusCode()).AsStr());
    if (r.StatusCode() == 200 && !Eq(method, "HEAD")) {
        str t = r.HeaderValue("Content-Type");
        if (Eq(target, "/assets/site.css") || Eq(target, "/assets/")) {
            write(1, " ");
            write(1, t);
            write(1, " [");
            write(1, r.BodyText());
            write(1, "]");
        } else {
            write(1, " ");
            write(1, r.BodyText());
        }
    }
    print("");
}

string Num(u32 v) {
    string s = string.New();
    if (v >= 100) s.AppendByte(('0' as u32 + v / 100) as u8);
    s.AppendByte(('0' as u32 + v / 10 % 10) as u8);
    s.AppendByte(('0' as u32 + v % 10) as u8);
    return s;
}

bool Eq(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

web.Html h = web.Html.New();
h.Open("p");
h.Attr("class", "x\"y");
h.Text("a < b & c");
h.Close("p");
h.Link("/?q=1&r=2", "go");
print(h.Done().AsStr());

var files = platform.FileSystem();
files.CreateDir("site");
files.CreateDir("site/static");
files.Write("site/static/site.css", "body{}");
files.Write("site/static/index.html", "index");
files.Write("site/secret.txt", "secret");

web.App app = web.App.New();
app.Get("/", new web.Page { Fn = Home });
app.Get("/docs/:page", new web.Page { Fn = DocPage });
app.Get("/files/*path", new web.Page { Fn = Rest });
app.Static("/assets", "site/static");
Show(ref files, app, "GET", "/");
Show(ref files, app, "GET", "/docs/intro");
Show(ref files, app, "GET", "/files/a/b/c");
Show(ref files, app, "POST", "/docs/x");
Show(ref files, app, "GET", "/nowhere");
Show(ref files, app, "GET", "/assets/site.css");
Show(ref files, app, "GET", "/assets/");
Show(ref files, app, "GET", "/assets/../secret.txt");
Show(ref files, app, "GET", "/assets/a\\b");
Show(ref files, app, "HEAD", "/");

List<str> paths = List<str>.New();
paths.Push("/");
paths.Push("/docs/intro.html");
Result<usize, IoError> built = web.Build(ref files, app, paths.AsSlice(), "out");
write(1, "built ");
write(1, Num(built.Unwrap() as u32).AsStr()[1..2]);
write(1, " files: home [");
write(1, files.Read("out/index.html").Unwrap().AsStr());
write(1, "], doc [");
write(1, files.Read("out/docs/intro.html").Unwrap().AsStr());
write(1, "], css [");
write(1, files.Read("out/assets/site.css").Unwrap().AsStr());
write(1, "], index [");
write(1, files.Read("out/assets/index.html").Unwrap().AsStr());
print("]");
write(1, "types: ");
write(1, web.TypeOf("a/logo.svg"));
write(1, " ");
write(1, web.TypeOf("envoc.wasm"));
write(1, " ");
print(web.TypeOf("dir.v2/noext"));

// serving: the same app over the in-memory network, one request
none.Net net = none.Net.New();
i64 listener = net.Listen("127.0.0.1", 8080).Unwrap();
i64 conn = net.Connect("localhost", 8080).Unwrap();
string wire = http.WriteRequest(http.Request.New("GET", "/docs/served"), "localhost");
List<u8> bytes = List<u8>.New();
for (usize i = 0; i < wire.Len(); i++) bytes.Push(wire.AsStr()[i]);
net.Send(conn, bytes.AsSlice());
web.ServeOneWith(ref net, ref files, ref app, listener);
string raw = string.New();
u8[256] buf;
while (true) {
    Result<usize, IoError> got = net.Recv(conn, buf[0..256]);
    if (got.IsErr() || got.Unwrap() == 0) break;
    for (usize i = 0; i < got.Unwrap(); i++) raw.AppendByte(buf[i]);
}
http.Response served = http.ParseResponse(raw.AsStr()).Unwrap();
write(1, "served: HTTP ");
write(1, Num(served.StatusCode()).AsStr());
write(1, " [");
write(1, served.BodyText());
print("]");
