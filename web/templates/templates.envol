// envoweb.templates: EnvoR's page templates (PLAN D51): CSS generated from EnvoR's tokens
// (light and dark, following the reader's setting), and the Landing and Docs pages. Every
// page has a skip link, landmarks (header, nav, main, footer), visible focus, and no
// scripts, cookies or third-party resources.
namespace envoweb.templates;

use envoweb as web;
use envor.theme;
use envoweb.markdown;
use alloc.text;

// ------------------------------------------------------------------ CSS

void Var(ref string css, str name, u32 rgb) {
    css.Append("  --");
    css.Append(name);
    css.Append(": #");
    css.Append(text.Hex(rgb as u64, 6).AsStr());
    css.Append(";\n");
}

void Colors(ref string css, in theme.Theme t) {
    Var(ref css, "bg", t.C.Background);
    Var(ref css, "surface", t.C.Surface);
    Var(ref css, "raised", t.C.SurfaceRaised);
    Var(ref css, "pressed", t.C.SurfacePressed);
    Var(ref css, "text", t.C.Text);
    Var(ref css, "text2", t.C.TextSecondary);
    Var(ref css, "sep", t.C.Separator);
    Var(ref css, "edge", t.C.ControlEdge);
    Var(ref css, "accent", t.C.Accent);
    Var(ref css, "accent-hover", t.C.AccentHover);
    Var(ref css, "on-accent", t.C.OnAccent);
    Var(ref css, "danger", t.C.Danger);
    Var(ref css, "success", t.C.Success);
    Var(ref css, "warning", t.C.Warning);
}

string Px(u32 v) {
    string s = text.Uint(v as u64);
    s.Append("px");
    return s;
}

void Size(ref string css, str name, in theme.TypeStyle t) {
    css.Append("  --");
    css.Append(name);
    css.Append(": ");
    css.Append(Px(t.Size).AsStr());
    css.Append("/");
    css.Append(Px(t.Line).AsStr());
    css.Append(" system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n");
}

// The site's stylesheet: EnvoR's light tokens, its dark ones when the reader prefers dark.
public string Css(in theme.Theme light, in theme.Theme dark) {
    string css = string.From("/* Generated by envoweb.templates from EnvoR's tokens (docs/lumen/). */\n:root {\n  color-scheme: light dark;\n");
    Colors(ref css, light);
    Size(ref css, "caption", light.Caption);
    Size(ref css, "body", light.Body);
    Size(ref css, "headline", light.Headline);
    Size(ref css, "title", light.Title);
    Size(ref css, "large-title", light.LargeTitle);
    css.Append("  --s: ");
    css.Append(Px(light.S).AsStr());
    css.Append(";\n  --m: ");
    css.Append(Px(light.M).AsStr());
    css.Append(";\n  --l: ");
    css.Append(Px(light.L).AsStr());
    css.Append(";\n  --xl: ");
    css.Append(Px(light.Xl).AsStr());
    css.Append(";\n  --xxl: ");
    css.Append(Px(light.Xxl).AsStr());
    css.Append(";\n  --r-s: ");
    css.Append(Px(light.RadiusSmall).AsStr());
    css.Append(";\n  --r-m: ");
    css.Append(Px(light.RadiusMedium).AsStr());
    css.Append(";\n  --r-l: ");
    css.Append(Px(light.RadiusLarge).AsStr());
    css.Append(";\n  --ring: ");
    css.Append(Px(light.FocusRing).AsStr());
    css.Append(";\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n");
    Colors(ref css, dark);
    css.Append("  }\n}\n");
    BaseCss(ref css);
    return css;
}

// The rules every EnvoR page uses, after the variables.
void BaseCss(ref string css) {
    css.Append("*, *::before, *::after { box-sizing: border-box; }\n");
    css.Append("html { -webkit-text-size-adjust: 100%; }\n");
    css.Append("body { margin: 0; font: var(--body); color: var(--text); background: var(--bg); }\n");
    css.Append("a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }\n");
    css.Append("a:hover { color: var(--accent-hover); }\n");
    css.Append(":focus-visible { outline: var(--ring) solid var(--accent); outline-offset: 2px; border-radius: 2px; }\n");
    css.Append(".skip { position: absolute; left: -9999px; top: var(--s); background: var(--accent); color: var(--on-accent); padding: var(--s) var(--m); border-radius: var(--r-m); z-index: 10; }\n");
    css.Append(".skip:focus { left: var(--s); }\n");
    css.Append("h1, h2, h3, h4 { line-height: 1.25; margin: var(--xl) 0 var(--m); }\n");
    css.Append("h1 { font: var(--large-title); font-weight: 700; letter-spacing: -0.01em; }\n");
    css.Append("h2 { font: var(--title); font-weight: 650; }\n");
    css.Append("h3 { font: var(--headline); font-weight: 650; }\n");
    css.Append("p, ul, ol, table, pre, blockquote { margin: 0 0 var(--l); }\n");
    css.Append("code, pre { font-family: ui-monospace, \"Cascadia Code\", Consolas, \"SF Mono\", monospace; font-size: 0.9em; }\n");
    css.Append(":not(pre) > code { background: var(--pressed); padding: 0.1em 0.35em; border-radius: var(--r-s); }\n");
    css.Append("pre { background: var(--surface); border: 1px solid var(--sep); border-radius: var(--r-m); padding: var(--m) var(--l); overflow-x: auto; line-height: 1.5; }\n");
    css.Append("blockquote { border-left: 3px solid var(--accent); margin-left: 0; padding: 0 var(--l); color: var(--text2); }\n");
    css.Append("table { border-collapse: collapse; display: block; overflow-x: auto; }\n");
    css.Append("th, td { border: 1px solid var(--sep); padding: var(--s) var(--m); text-align: left; vertical-align: top; }\n");
    css.Append("th { background: var(--surface); }\n");
    css.Append("hr { border: 0; border-top: 1px solid var(--sep); margin: var(--xl) 0; }\n");
    css.Append("img { max-width: 100%; }\n");
    css.Append(".bar { display: flex; align-items: center; gap: var(--l); padding: var(--m) var(--xl); border-bottom: 1px solid var(--sep); background: var(--surface); position: sticky; top: 0; z-index: 5; }\n");
    css.Append(".brand { font: var(--headline); font-weight: 700; color: var(--text); text-decoration: none; display: inline-flex; align-items: center; gap: var(--s); }\n");
    css.Append(".bar nav { display: flex; gap: var(--l); flex-wrap: wrap; }\n");
    css.Append(".bar nav a { color: var(--text2); text-decoration: none; }\n");
    css.Append(".bar nav a:hover, .bar nav a[aria-current] { color: var(--text); }\n");
    css.Append(".docs { display: grid; grid-template-columns: 260px minmax(0, 1fr) 220px; gap: var(--xl); max-width: 1320px; margin: 0 auto; padding: 0 var(--xl); }\n");
    css.Append(".side { position: sticky; top: 64px; align-self: start; max-height: calc(100vh - 64px); overflow-y: auto; padding: var(--l) 0; font: var(--caption); }\n");
    css.Append(".side ul { list-style: none; padding: 0; margin: 0; }\n");
    css.Append(".side li a { display: block; padding: 4px var(--s); border-radius: var(--r-s); color: var(--text2); text-decoration: none; }\n");
    css.Append(".side li a:hover { background: var(--pressed); color: var(--text); }\n");
    css.Append(".side li a[aria-current] { background: var(--pressed); color: var(--text); font-weight: 600; }\n");
    css.Append(".side .group { margin-top: var(--l); color: var(--text); font-weight: 650; padding: 0 var(--s); }\n");
    css.Append(".side .d1 a { padding-left: var(--l); }\n");
    css.Append(".side .d2 a { padding-left: var(--xl); }\n");
    css.Append(".content { padding: var(--l) 0 var(--xxl); min-width: 0; }\n");
    css.Append(".toc { font: var(--caption); }\n");
    css.Append(".toc h2 { font: var(--caption); font-weight: 650; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text2); margin-top: 0; }\n");
    css.Append(".toc ul { list-style: none; padding: 0; }\n");
    css.Append(".toc li.l3 { padding-left: var(--m); }\n");
    css.Append(".toc a { color: var(--text2); text-decoration: none; }\n");
    css.Append(".toc a:hover { color: var(--text); }\n");
    css.Append(".hero { text-align: center; padding: var(--xxl) var(--xl); max-width: 860px; margin: 0 auto; }\n");
    css.Append(".hero h1 { font-size: 48px; line-height: 1.1; margin-top: var(--xl); }\n");
    css.Append(".lead { font: var(--headline); color: var(--text2); }\n");
    css.Append(".actions { display: flex; gap: var(--m); justify-content: center; flex-wrap: wrap; margin-top: var(--xl); }\n");
    css.Append(".button { display: inline-block; padding: var(--s) var(--l); border-radius: var(--r-m); font-weight: 600; text-decoration: none; border: 1px solid var(--edge); color: var(--text); background: var(--raised); }\n");
    css.Append(".button:hover { background: var(--pressed); color: var(--text); }\n");
    css.Append(".button.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }\n");
    css.Append(".button.primary:hover { background: var(--accent-hover); color: var(--on-accent); }\n");
    css.Append(".features { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--l); max-width: 1100px; margin: 0 auto; padding: 0 var(--xl) var(--xxl); }\n");
    css.Append(".card { background: var(--surface); border: 1px solid var(--sep); border-radius: var(--r-l); padding: var(--l) var(--xl); }\n");
    css.Append(".card h2 { font: var(--headline); font-weight: 650; margin-top: var(--s); }\n");
    css.Append(".card p { color: var(--text2); margin-bottom: var(--s); }\n");
    css.Append(".section { max-width: 860px; margin: 0 auto; padding: 0 var(--xl) var(--xxl); }\n");
    css.Append("footer { border-top: 1px solid var(--sep); padding: var(--l) var(--xl); color: var(--text2); font: var(--caption); text-align: center; }\n");
    css.Append("button.button { cursor: pointer; font: inherit; }\n");
    css.Append("button.button:disabled { opacity: 0.6; cursor: default; }\n");
    css.Append("select, textarea { font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--edge); border-radius: var(--r-m); padding: var(--s) var(--m); }\n");
    css.Append("textarea.code { display: block; width: 100%; min-height: 280px; font-family: ui-monospace, \"Cascadia Code\", Consolas, monospace; font-size: 14px; line-height: 1.5; tab-size: 4; resize: vertical; }\n");
    css.Append(".toolbar { display: flex; gap: var(--m); align-items: center; flex-wrap: wrap; margin: var(--m) 0; }\n");
    css.Append("pre.output { min-height: 120px; white-space: pre-wrap; }\n");
    css.Append(".visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n");
    css.Append("@media (max-width: 1100px) { .docs { grid-template-columns: 220px minmax(0, 1fr); } .toc { display: none; } }\n");
    css.Append("@media (max-width: 760px) { .docs { grid-template-columns: minmax(0, 1fr); } .side { position: static; max-height: none; } .bar { padding: var(--s) var(--l); } }\n");
    css.Append("@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }\n");
}
// ------------------------------------------------------------------ pages

// A link in the site's top bar or a docs page's side navigation. A group is a heading
// with no link.
public struct NavItem {
    string Title;
    string Href;
    u32 Depth;
    bool Group;

    public static NavItem Link(str title, str href, u32 depth) => new NavItem { Title = string.From(title), Href = string.From(href), Depth = depth, Group = false };
    public static NavItem Heading(str title) => new NavItem { Title = string.From(title), Href = string.New(), Depth = 0, Group = true };
}

// What every page shares: the site's name, its home, its stylesheet's address, the top
// bar's links and the footer.
public struct Frame {
    string Site;
    string Home;
    string CssHref;
    List<NavItem> Top;
    string Footer;
    string Logo;        // the site's mark (an SVG), beside its name and as the icon; empty for none

    public static Frame New(str site, str home, str cssHref) => new Frame { Site = string.From(site), Home = string.From(home), CssHref = string.From(cssHref), Top = List<NavItem>.New(), Footer = string.New(), Logo = string.New() };
}

void Head(ref web.Html h, in Frame f, str title, str description) {
    h.Raw("<!doctype html>\n");
    h.Open("html");
    h.Attr("lang", "en");
    h.Raw("\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n");
    h.Open("title");
    h.Text(title);
    if (!Same(title, f.Site.AsStr())) {
        h.Text(" · ");
        h.Text(f.Site.AsStr());
    }
    h.Close("title");
    h.Line();
    if (description.Len > 0) {
        h.Open("meta");
        h.Attr("name", "description");
        h.Attr("content", description);
        h.Raw("\n");
    }
    if (f.Logo.Len() > 0) {
        h.Open("link");
        h.Attr("rel", "icon");
        h.Attr("type", "image/svg+xml");
        h.Attr("href", f.Logo.AsStr());
        h.Raw("\n");
    }
    h.Open("link");
    h.Attr("rel", "stylesheet");
    h.Attr("href", f.CssHref.AsStr());
    h.Raw("\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n");
}

void Bar(ref web.Html h, in Frame f, str current) {
    h.Raw("<header class=\"bar\">\n");
    h.Open("a");
    h.Attr("class", "brand");
    h.Attr("href", f.Home.AsStr());
    if (f.Logo.Len() > 0) {
        h.Open("img");
        h.Attr("src", f.Logo.AsStr());
        h.Attr("alt", "");
        h.Attr("width", "28");
        h.Attr("height", "28");
    }
    h.Text(f.Site.AsStr());
    h.Close("a");
    h.Raw("\n<nav aria-label=\"Site\">");
    NavItem[] top = f.Top.AsSlice();
    for (usize i = 0; i < top.Len; i++) {
        h.Open("a");
        h.Attr("href", top[i].Href.AsStr());
        if (top[i].Href.Equals(current)) h.Attr("aria-current", "page");
        h.Text(top[i].Title.AsStr());
        h.Close("a");
    }
    h.Raw("</nav>\n</header>\n");
}

void Foot(ref web.Html h, in Frame f) {
    h.Raw("<footer>");
    if (f.Footer.Len() > 0) h.Text(f.Footer.AsStr());
    else {
        h.Text("Built with EnvoScale: ");
        h.Text("this page was made by an EnvoL program.");
    }
    h.Raw("</footer>\n</body>\n</html>\n");
}

// A documentation page: the side navigation (the current page marked), the content, and
// the page's contents from its headings.
public string Docs(in Frame f, str title, str description, in List<NavItem> nav, str current, in markdown.Doc doc) {
    web.Html h = web.Html.New();
    Head(ref h, f, title, description);
    Bar(ref h, f, current);
    h.Raw("<div class=\"docs\">\n<nav class=\"side\" aria-label=\"Documentation\">\n<ul>\n");
    NavItem[] items = nav.AsSlice();
    for (usize i = 0; i < items.Len; i++) {
        if (items[i].Group) {
            h.Open("li");
            h.Attr("class", "group");
            h.Text(items[i].Title.AsStr());
            h.Close("li");
            h.Line();
            continue;
        }
        h.Open("li");
        if (items[i].Depth == 1) h.Attr("class", "d1");
        if (items[i].Depth > 1) h.Attr("class", "d2");
        h.Open("a");
        h.Attr("href", items[i].Href.AsStr());
        if (items[i].Href.Equals(current)) h.Attr("aria-current", "page");
        h.Text(items[i].Title.AsStr());
        h.Close("a");
        h.Close("li");
        h.Line();
    }
    h.Raw("</ul>\n</nav>\n<main id=\"main\" class=\"content\">\n");
    h.Raw(doc.HtmlOf());
    h.Raw("</main>\n<aside class=\"toc\" aria-label=\"On this page\">\n");
    markdown.Heading[] hs = doc.HeadingList();
    bool any = false;
    for (usize i = 0; i < hs.Len; i++) {
        u32 lv = hs[i].LevelOf();
        if (lv != 2 && lv != 3) continue;
        if (!any) {
            h.Raw("<h2>On this page</h2>\n<ul>\n");
            any = true;
        }
        h.Open("li");
        if (lv == 3) h.Attr("class", "l3");
        string href = string.From("#");
        href.Append(hs[i].IdOf());
        h.Link(href.AsStr(), hs[i].TextOf());
        h.Close("li");
        h.Line();
    }
    if (any) h.Raw("</ul>\n");
    h.Raw("</aside>\n</div>\n");
    Foot(ref h, f);
    return h.Done();
}

// A card on a landing page.
public struct Feature {
    string Title;
    string Text;
    string Href;

    public static Feature Of(str title, str text, str href) => new Feature { Title = string.From(title), Text = string.From(text), Href = string.From(href) };
}

// A landing page: the hero (title, lead, two actions), feature cards, then more content
// (HTML, for example from Markdown).
public struct Landing {
    string Title;
    string Lead;
    string PrimaryText;
    string PrimaryHref;
    string SecondaryText;
    string SecondaryHref;
    List<Feature> Features;
    string Body;

    public static Landing New(str title, str lead) => new Landing {
        Title = string.From(title), Lead = string.From(lead), PrimaryText = string.New(), PrimaryHref = string.New(),
        SecondaryText = string.New(), SecondaryHref = string.New(), Features = List<Feature>.New(), Body = string.New(),
    };
}

public string LandingPage(in Frame f, in Landing l) {
    web.Html h = web.Html.New();
    Head(ref h, f, f.Site.AsStr(), l.Lead.AsStr());
    Bar(ref h, f, f.Home.AsStr());
    h.Raw("<main id=\"main\">\n<section class=\"hero\">\n");
    h.Element("h1", l.Title.AsStr());
    h.Line();
    h.Open("p");
    h.Attr("class", "lead");
    h.Text(l.Lead.AsStr());
    h.Close("p");
    h.Raw("\n<div class=\"actions\">");
    if (l.PrimaryText.Len() > 0) {
        h.Open("a");
        h.Attr("class", "button primary");
        h.Attr("href", l.PrimaryHref.AsStr());
        h.Text(l.PrimaryText.AsStr());
        h.Close("a");
    }
    if (l.SecondaryText.Len() > 0) {
        h.Open("a");
        h.Attr("class", "button");
        h.Attr("href", l.SecondaryHref.AsStr());
        h.Text(l.SecondaryText.AsStr());
        h.Close("a");
    }
    h.Raw("</div>\n</section>\n");
    Feature[] fs = l.Features.AsSlice();
    if (fs.Len > 0) {
        h.Raw("<section class=\"features\" aria-label=\"Highlights\">\n");
        for (usize i = 0; i < fs.Len; i++) {
            h.Raw("<div class=\"card\">");
            h.Open("h2");
            if (fs[i].Href.Len() > 0) h.Link(fs[i].Href.AsStr(), fs[i].Title.AsStr());
            else h.Text(fs[i].Title.AsStr());
            h.Close("h2");
            h.Element("p", fs[i].Text.AsStr());
            h.Raw("</div>\n");
        }
        h.Raw("</section>\n");
    }
    if (l.Body.Len() > 0) {
        h.Raw("<section class=\"section\">\n");
        h.Raw(l.Body.AsStr());
        h.Raw("</section>\n");
    }
    h.Raw("</main>\n");
    Foot(ref h, f);
    return h.Done();
}

bool Same(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}
