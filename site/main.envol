// The EnvoScale website, written in EnvoL. The home page uses EnvoR's Landing template;
// every Markdown document of the EnvoScale documentation uses the Docs template. Pages
// keep the documents' paths (envol/README.md becomes envol/README.html), so their links
// to each other work, and every link is relative, so the site works under any address.
//
//   envo build site                   build/site
//   site build [folder]               static files into folder (default build/site)
//   site serve [port]                 the same pages, rendered per request (default 8080)
//
// Run it from an EnvoScale (documentation) checkout. The sandbox page needs EnvoLang's
// JavaScript host and its compiler built for WebAssembly: set ENVOLANG to an EnvoLang
// checkout to include it. Static generation and serving are one code path:
// a page is a function from a request to a response (envoweb).
use envoweb as web;
use envoweb.templates;
use envoweb.markdown;
use envor.theme;
use envo.http;
use std.fs;
use std.env;
use alloc.text;

const str SITE = "EnvoScale";

// The EnvoScale mark: an E whose bars widen toward its base.
const str LOGO_SVG = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\" width=\"512\" height=\"512\"><title>EnvoScale</title><rect width=\"512\" height=\"512\" rx=\"112\" fill=\"#0a64d4\"/><g fill=\"#ffffff\"><rect x=\"112\" y=\"120\" width=\"56\" height=\"272\" rx=\"12\"/><rect x=\"112\" y=\"120\" width=\"176\" height=\"56\" rx=\"12\"/><rect x=\"112\" y=\"228\" width=\"232\" height=\"56\" rx=\"12\"/><rect x=\"112\" y=\"336\" width=\"288\" height=\"56\" rx=\"12\"/></g></svg>\n";

// ------------------------------------------------------------------ the pages

// The Markdown files the site publishes, as paths in the checkout ("envol/README.md").
List<string> Sources() {
    List<string> all = List<string>.New();
    List<string> dirs = List<string>.New();
    dirs.Push(string.From("."));
    while (dirs.Len() > 0) {
        string dir = dirs.Pop().Unwrap();
        var r = fs.ListDir(dir.AsStr());
        if (r.IsErr()) continue;
        List<string> names = r.Unwrap();
        string[] ns = names.AsSlice();
        for (usize i = 0; i < ns.Len; i++) {
            str n = ns[i].AsStr();
            if (n.Len == 0 || (n[0] == '.' && !IsText(n, ".github"))) continue;
            string p = string.New();
            if (!dir.Equals(".")) {
                p.Append(dir.AsStr());
                p.AppendByte('/');
            }
            p.Append(n);
            if (fs.IsDir(p.AsStr())) {
                if (IsText(n, "build") || IsText(n, "node_modules")) continue;
                dirs.Push(p);
            } else if (HasSuffix(n, ".md")) {
                all.Push(p);
            }
        }
    }
    return all;
}

// The site path of a Markdown file: "/envol/README.html".
string PageOf(str source) {
    string s = string.From("/");
    s.Append(source[0..source.Len - 3]);
    s.Append(".html");
    return s;
}

// target, relative to the page at path from (both site paths starting with "/").
string Rel(str from, str target) {
    string s = string.New();
    for (usize i = 1; i < from.Len; i++) {
        if (from[i] == '/') s.Append("../");
    }
    if (target.Len <= 1) s.Append("index.html");
    else s.Append(target[1..target.Len]);
    return s;
}

// A document's title: its first level-1 heading (only that line is rendered), else its
// file name.
string TitleOf(str source) {
    var r = fs.ReadText(source);
    if (r.IsOk()) {
        string src = r.Unwrap();
        str t = src.AsStr();
        usize i = 0;
        while (i < t.Len) {
            usize e = i;
            while (e < t.Len && t[e] != 10) e++;
            if (e - i > 2 && t[i] == '#' && t[i + 1] == ' ') {
                markdown.Doc d = markdown.Render(t[i..e], markdown.Options.Site());
                if (d.Title().Len > 0) return string.From(d.Title());
            }
            i = e + 1;
        }
    }
    return string.From(source);
}

void Add(ref List<templates.NavItem> nav, str from, str title, str source, u32 depth) {
    if (!fs.IsFile(source)) return;
    string page = PageOf(source);
    string href = Rel(from, page.AsStr());
    nav.Push(templates.NavItem.Link(title, href.AsStr(), depth));
}

void Group(ref List<templates.NavItem> nav, str from, str title, str dir) {
    nav.Push(templates.NavItem.Heading(title));
    var r = fs.ListDir(dir);
    if (r.IsErr()) return;
    List<string> names = r.Unwrap();
    string[] ns = names.AsSlice();
    for (usize i = 0; i < ns.Len; i++) {
        str n = ns[i].AsStr();
        if (!HasSuffix(n, ".md")) continue;
        string source = string.From(dir);
        source.AppendByte('/');
        source.Append(n);
        string title2 = TitleOf(source.AsStr());
        if (IsText(n, "README.md")) {
            // the folder's overview first
            Add(ref nav, from, "Overview", source.AsStr(), 0);
        }
    }
    for (usize i = 0; i < ns.Len; i++) {
        str n = ns[i].AsStr();
        if (!HasSuffix(n, ".md") || IsText(n, "README.md")) continue;
        string source = string.From(dir);
        source.AppendByte('/');
        source.Append(n);
        string title2 = TitleOf(source.AsStr());
        Add(ref nav, from, title2.AsStr(), source.AsStr(), 0);
    }
}

// The library modules that have landed, by their READMEs' status line.
// The side navigation, its links relative to the page at from.
List<templates.NavItem> Nav(str from) {
    List<templates.NavItem> nav = List<templates.NavItem>.New();
    nav.Push(templates.NavItem.Heading("Start"));
    Add(ref nav, from, "Overview", "README.md", 0);
    Add(ref nav, from, "Getting started", "getting-started.md", 0);
    Add(ref nav, from, "A tour of EnvoL", "envol/README.md", 0);
    nav.Push(templates.NavItem.Heading("Projects"));
    Add(ref nav, from, "EnvoPM", "envopm/README.md", 0);
    Add(ref nav, from, "EnvoR", "envor/README.md", 0);
    Add(ref nav, from, "EnvoUI", "envoui/README.md", 0);
    Add(ref nav, from, "EnvIDE", "envide/README.md", 0);
    Add(ref nav, from, "EnvoWeb", "envoweb/README.md", 0);
    Add(ref nav, from, "EnvOS", "envos/README.md", 0);
    Group(ref nav, from, "How it is built", "architecture");
    Add(ref nav, from, "Bootstrap", "bootstrap/bootstrap.md", 0);
    Add(ref nav, from, "Porting", "porting/README.md", 0);
    nav.Push(templates.NavItem.Heading("Project"));
    Add(ref nav, from, "Status", "project/status.md", 0);
    Add(ref nav, from, "Plan", "project/plan.md", 0);
    Add(ref nav, from, "Principles", "project/principles.md", 0);
    Add(ref nav, from, "RFCs", "rfcs/README.md", 0);
    nav.Push(templates.NavItem.Heading("Organizations"));
    Add(ref nav, from, "Enterprise", "guides/enterprise.md", 0);
    Add(ref nav, from, "Offline install", "guides/offline-install.md", 0);
    Add(ref nav, from, "Licensing", "legal/licensing.md", 0);
    Add(ref nav, from, "Trademarks", "legal/trademarks.md", 0);
    return nav;
}

templates.Frame FrameFor(str page) {
    string home = Rel(page, "/");
    string css = Rel(page, "/theme.css");
    templates.Frame f = templates.Frame.New(SITE, home.AsStr(), css.AsStr());
    string logo = Rel(page, "/logo.svg");
    f.Logo = logo;
    f.Top.Push(templates.NavItem.Link("Docs", Rel(page, "/README.html").AsStr(), 0));
    f.Top.Push(templates.NavItem.Link("Get started", Rel(page, "/getting-started.html").AsStr(), 0));
    f.Top.Push(templates.NavItem.Link("Language", Rel(page, "/envol/README.html").AsStr(), 0));
    if (HasSandbox()) f.Top.Push(templates.NavItem.Link("Sandbox", Rel(page, "/sandbox/").AsStr(), 0));
    f.Top.Push(templates.NavItem.Link("Status", Rel(page, "/project/status.html").AsStr(), 0));
    f.Footer = string.From("EnvoScale. This site is an EnvoL program, built with EnvoWeb and EnvoR.");
    return f;
}

http.Response Home() {
    templates.Frame f = FrameFor("/");
    templates.Landing l = templates.Landing.New("One language for everything you build.", "EnvoL is a programming language, and EnvoScale is everything around it in one place: the compiler, the standard library and the envo tool. Command-line programs, servers, desktop and terminal apps, websites, graphics and AI, with no third-party code anywhere.");
    l.PrimaryText = string.From("Get started");
    l.PrimaryHref = string.From("getting-started.html");
    l.SecondaryText = string.From("See where it stands");
    l.SecondaryHref = string.From("project/status.html");
    l.Features.Push(templates.Feature.Of("One language", "EnvoL compiles to native code: scripts, apps, servers and low-level code in one language, from a one-line program up.", "envol/README.html"));
    l.Features.Push(templates.Feature.Of("Built from the ground up", "A few kilobytes of readable assembly build the compiler that EnvoScale starts from, and the compiler rebuilds itself to the same bytes on every OS. Every step is checked in CI.", "https://github.com/envoscale/EnvoScaleAsm"));
    l.Features.Push(templates.Feature.Of("Every platform is an adapter", "Programs talk to ports; Windows, Linux and WebAssembly are adapters behind them, and each passes the same conformance suites.", "architecture/ports-and-adapters.html"));
    l.Features.Push(templates.Feature.Of("Batteries, not dependencies", "Crypto and TLS, HTTP, terminal and desktop UI, fonts, 2D and GPU drawing, all in the standard platform, all written in EnvoL.", "envol/README.html"));
    markdown.Doc body = markdown.Render(HOME_BODY, markdown.Options.Site());
    l.Body = string.From(body.HtmlOf());
    return http.Response.Html(200, templates.LandingPage(f, l).AsStr());
}

const str HOME_BODY = "## Hello, World\n\n```envo\nprint(\"Hello, World!\");\n```\n\nOne line is a whole program, and the same language takes you to servers, windows and websites: the [tour](envol/README.html) shows more.\n\n## Try it\n\nDownload a release from [GitHub](https://github.com/envoscale/EnvoLang/releases), or build from source with only what your OS ships: `./build.sh build` on Linux and Git Bash, `.\\build.ps1 build` on Windows. The [status page](project/status.html) says what works today.\n";

http.Response DocPage(str page, str source) {
    var r = fs.ReadText(source);
    if (r.IsErr()) return http.Response.Html(404, "<!doctype html>\n<title>Not found</title>\n<h1>Not found</h1>\n");
    string src = r.Unwrap();
    markdown.Doc d = markdown.Render(src.AsStr(), markdown.Options.Site());
    string title = string.From(d.Title());
    if (title.Len() == 0) title = string.From(source);
    templates.Frame f = FrameFor(page);
    List<templates.NavItem> nav = Nav(page);
    string current = Rel(page, page);
    string html = templates.Docs(f, title.AsStr(), "", nav, current.AsStr(), d);
    return http.Response.Html(200, html.AsStr());
}

// The sandbox: the compiler, built for WebAssembly (build/envoc.wasm), compiles and runs
// programs in the page (the website plan, phase 3b).
http.Response Sandbox() {
    templates.Frame f = FrameFor("/sandbox/index.html");
    templates.Landing l = templates.Landing.New("Sandbox", "EnvoL in your browser: the compiler itself, built for WebAssembly, compiles your program on this page and runs it there. Nothing you type leaves your machine.");
    l.Body = string.From(SANDBOX_BODY);
    return http.Response.Html(200, templates.LandingPage(f, l).AsStr());
}

const str SANDBOX_BODY = "<div class=\"sandbox\">\n<div class=\"toolbar\">\n<label for=\"example\">Example</label>\n<select id=\"example\">\n<option value=\"hello\">Hello, World</option>\n<option value=\"fizzbuzz\">FizzBuzz</option>\n<option value=\"structs\">Structs and methods</option>\n<option value=\"generics\">Generics</option>\n<option value=\"panic\">A panic</option>\n</select>\n<button id=\"run\" class=\"button primary\" type=\"button\" disabled>Run</button>\n<button id=\"share\" class=\"button\" type=\"button\">Share</button>\n</div>\n<label for=\"code\" class=\"visually-hidden\">Program</label>\n<textarea id=\"code\" class=\"code\" spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\"></textarea>\n<h2>Output</h2>\n<pre id=\"out\" class=\"output\" aria-live=\"polite\">Loading the compiler…</pre>\n<p>The sandbox has the language and its prelude (List, string, Option, Result). The standard platform (std, envo.*) is not in the page yet.</p>\n</div>\n<script src=\"envo.js\"></script>\n<script src=\"sandbox.js\"></script>\n";

// A file of the repository as a response of type type, or 404.
// path inside the EnvoLang checkout named by ENVOLANG.
string InLang(str path) {
    string root = env.Var("ENVOLANG") ?? string.From(".");
    root.AppendByte('/');
    root.Append(path);
    return root;
}

// Does ENVOLANG name an EnvoLang checkout with the compiler built for WebAssembly?
bool HasSandbox() {
    string wasm = InLang("build/envoc.wasm");
    return env.Var("ENVOLANG").IsSome() && fs.IsFile(wasm.AsStr());
}

http.Response FileOf(str source, str type) {
    var r = fs.ReadText(source);
    if (r.IsErr()) return http.Response.Html(404, "<!doctype html>\n<title>Not found</title>\n<h1>Not found</h1>\n");
    string body = r.Unwrap();
    http.Response resp = http.Response.Text(200, body.AsStr());
    resp.SetHeader("Content-Type", type);
    return resp;
}

// Every page of the site, by its path.
http.Response SitePage(in http.Request req, in web.Params ps) {
    str path = ps.Get("path");
    if (path.Len == 0 || IsText(path, "index.html")) return Home();
    if (IsText(path, "sandbox") || IsText(path, "sandbox/") || IsText(path, "sandbox/index.html")) return Sandbox();
    if (IsText(path, "sandbox/envo.js")) return FileOf(InLang("adapters/interop/js/envo.js").AsStr(), "text/javascript; charset=utf-8");
    if (IsText(path, "sandbox/sandbox.js")) return FileOf(InLang("adapters/interop/js/sandbox.js").AsStr(), "text/javascript; charset=utf-8");
    if (IsText(path, "sandbox/envoc.wasm")) return FileOf(InLang("build/envoc.wasm").AsStr(), "application/wasm");
    if (IsText(path, "logo.svg")) {
        http.Response svg = http.Response.Text(200, LOGO_SVG);
        svg.SetHeader("Content-Type", "image/svg+xml");
        return svg;
    }
    if (IsText(path, "theme.css")) {
        http.Response css = http.Response.Text(200, templates.Css(theme.Light(), theme.Dark()).AsStr());
        css.SetHeader("Content-Type", "text/css; charset=utf-8");
        return css;
    }
    if (HasSuffix(path, ".html") && !HasText(path, "..")) {
        string source = string.From(path[0..path.Len - 5]);
        source.Append(".md");
        if (fs.IsFile(source.AsStr())) {
            string page = string.From("/");
            page.Append(path);
            return DocPage(page.AsStr(), source.AsStr());
        }
    }
    return http.Response.Html(404, "<!doctype html>\n<title>Not found</title>\n<h1>Not found</h1>\n");
}

// ------------------------------------------------------------------ the program

web.App app = web.App.New();
app.Get("/*path", new web.Page { Fn = SitePage });
List<str> args = env.Args();
str[] a = args.AsSlice();
str command = "build";
if (a.Len > 0) command = a[0];
if (IsText(command, "serve")) {
    u16 port = 8080;
    if (a.Len > 1) port = ParsePort(a[1]);
    write(1, "serving the site on http://127.0.0.1:");
    print(text.Uint(port as u64).AsStr());
    web.Serve(ref app, "127.0.0.1", port);
} else if (IsText(command, "build")) {
    str out0 = "build/site";
    if (a.Len > 1) out0 = a[1];
    List<string> sources = Sources();
    List<string> pages = List<string>.New();
    pages.Push(string.From("/"));
    pages.Push(string.From("/theme.css"));
    pages.Push(string.From("/logo.svg"));
    if (HasSandbox()) {
        pages.Push(string.From("/sandbox/"));
        pages.Push(string.From("/sandbox/envo.js"));
        pages.Push(string.From("/sandbox/sandbox.js"));
        pages.Push(string.From("/sandbox/envoc.wasm"));
    }
    string[] ss = sources.AsSlice();
    for (usize i = 0; i < ss.Len; i++) pages.Push(PageOf(ss[i].AsStr()));
    List<str> paths = List<str>.New();
    string[] ps = pages.AsSlice();
    for (usize i = 0; i < ps.Len; i++) paths.Push(ps[i].AsStr());
    var files = platform.FileSystem();
    var r = web.Build(ref files, app, paths.AsSlice(), out0);
    if (r.IsErr()) {
        print("site: the build failed");
        exit(1);
    }
    write(1, "site: ");
    write(1, text.Uint(r.Unwrap() as u64).AsStr());
    write(1, " files in ");
    print(out0);
} else {
    print("usage: site build [folder] | site serve [port]");
    exit(2);
}

u16 ParsePort(str s) {
    u32 v = 0;
    for (usize i = 0; i < s.Len; i++) {
        if (s[i] < '0' || s[i] > '9') return 8080;
        v = v * 10 + (s[i] - '0') as u32;
        if (v > 65535) return 8080;
    }
    return v as u16;
}

bool IsText(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

bool HasSuffix(str s, str t) {
    if (s.Len < t.Len) return false;
    for (usize i = 0; i < t.Len; i++) {
        if (s[s.Len - t.Len + i] != t[i]) return false;
    }
    return true;
}

bool HasText(str s, str t) {
    if (t.Len == 0) return true;
    for (usize i = 0; i + t.Len <= s.Len; i++) {
        bool all = true;
        for (usize k = 0; k < t.Len; k++) {
            if (s[i + k] != t[k]) {
                all = false;
                break;
            }
        }
        if (all) return true;
    }
    return false;
}
