    name    = "site"
    version = "0.1.0"
}
dependencies {
    envoweb = { path = ".." }
    envor   = { git = "https://github.com/envoscale/Envor", rev = "596ea4c3fbd47bb2a3967780b9da33544a4e9dd5" }
}
